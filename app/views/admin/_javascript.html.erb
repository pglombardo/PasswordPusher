<%= javascript_importmap_tags %>

<%= stylesheet_link_tag PasswordPusher::Theme.stylesheet_logical_name, "data-turbo-track": "reload" %>

<style>
  /* Admin Navigation Styling */
  .hover-bg-light:hover {
    background-color: rgba(0, 0, 0, 0.05) !important;
  }

  .transition-all {
    transition: all 0.2s ease-in-out;
  }

  /* Active state styling */
  .bg-primary.bg-opacity-10 {
    background-color: rgba(var(--bs-primary-rgb), 0.1) !important;
  }

  /* Hover effects for navigation links */
  .sidebar-nav-link {
    color: var(--bs-secondary-color);
    transition: all 0.2s ease-in-out;
  }

  .sidebar-nav-link:hover {
    color: var(--bs-emphasis-color);
    background-color: rgba(0, 0, 0, 0.05);
    transform: translateX(2px);
  }

  .sidebar-nav-link.active {
    color: var(--bs-primary);
    background-color: rgba(var(--bs-primary-rgb), 0.1);
    font-weight: 600;
  }

  /* Dark Theme Support — follows data-bs-theme (toggle / PWP__THEME_MODE), not OS alone.
     Admin views use fixed-polarity Bootstrap utilities such as .bg-white,
     .bg-light and .text-dark. Correct those utilities because Bootswatch themes
     do not consistently remap them for dark mode. Colours come from the default
     theme's --pwp-* surface ladder, with --bs-* fallbacks for other themes.
     Fully-qualified selectors (no nesting) so this raw <style> block is portable. */
  html[data-bs-theme="dark"] body.bg-light {
    background-color: var(--bs-body-bg) !important;
  }

  html[data-bs-theme="dark"] .bg-white,
  html[data-bs-theme="dark"] .bg-light:not(body) {
    background-color: var(--pwp-surface-1, var(--bs-secondary-bg)) !important;
  }

  html[data-bs-theme="dark"] .bg-white {
    border-color: var(--pwp-border, var(--bs-border-color)) !important;
  }

  html[data-bs-theme="dark"] .text-dark {
    color: var(--pwp-text, var(--bs-emphasis-color)) !important;
  }

  html[data-bs-theme="dark"] .sidebar-nav-link {
    color: var(--bs-secondary-color);
  }

  html[data-bs-theme="dark"] .sidebar-nav-link:hover {
    color: var(--bs-emphasis-color);
    background-color: rgba(255, 255, 255, 0.06);
  }

  html[data-bs-theme="dark"] .sidebar-nav-link.active {
    color: var(--pwp-accent-text, var(--bs-link-color));
    background-color: rgba(var(--bs-primary-rgb), 0.18);
  }

  html[data-bs-theme="dark"] .hover-bg-light:hover {
    background-color: rgba(255, 255, 255, 0.08) !important;
  }

  html[data-bs-theme="dark"] .breadcrumb-item a {
    color: var(--bs-secondary-color) !important;
  }

  html[data-bs-theme="dark"] .breadcrumb-item.active {
    color: var(--bs-emphasis-color) !important;
  }

  html[data-bs-theme="dark"] nav a.text-decoration-none,
  html[data-bs-theme="dark"] footer a {
    color: var(--bs-secondary-color) !important;
  }

  html[data-bs-theme="dark"] nav a.text-decoration-none:hover,
  html[data-bs-theme="dark"] footer a:hover {
    color: var(--bs-emphasis-color) !important;
  }

  /* Madmin-style fields that are rendered without Bootstrap's .form-control. */
  html[data-bs-theme="dark"] input[type="text"],
  html[data-bs-theme="dark"] input[type="email"],
  html[data-bs-theme="dark"] input[type="password"],
  html[data-bs-theme="dark"] input[type="number"],
  html[data-bs-theme="dark"] input[type="datetime-local"],
  html[data-bs-theme="dark"] select,
  html[data-bs-theme="dark"] textarea {
    background-color: var(--pwp-surface-1, var(--bs-secondary-bg));
    border-color: var(--pwp-border-strong, var(--bs-border-color));
    color: var(--bs-body-color);
  }

  html[data-bs-theme="dark"] input[type="text"]:focus,
  html[data-bs-theme="dark"] input[type="email"]:focus,
  html[data-bs-theme="dark"] input[type="password"]:focus,
  html[data-bs-theme="dark"] input[type="number"]:focus,
  html[data-bs-theme="dark"] input[type="datetime-local"]:focus,
  html[data-bs-theme="dark"] select:focus,
  html[data-bs-theme="dark"] textarea:focus {
    background-color: var(--pwp-surface-2, var(--bs-tertiary-bg));
    border-color: var(--pwp-accent, var(--bs-primary));
    color: var(--bs-emphasis-color);
  }
</style>
