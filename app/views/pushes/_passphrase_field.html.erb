<div class="passphrase-field"
     data-controller="passphrase-field"
     data-passphrase-field-generate-url-value="<%= api_v2_generate_path %>"
     data-passphrase-field-language-default-value="<%= pwgen_default_language %>"
     data-passphrase-field-word-count-default-value="<%= Settings.gen.passphrase.word_count %>"
     data-passphrase-field-separator-default-value="<%= Settings.gen.passphrase.separator %>"
     data-passphrase-field-capitalize-default-value="<%= Settings.gen.passphrase.capitalize %>"
     data-passphrase-field-number-default-value="<%= Settings.gen.passphrase.number %>"
     data-passphrase-field-symbol-default-value="<%= Settings.gen.passphrase.symbol %>"
     data-passphrase-field-failed-value="<%= _('Password generation failed.') %>">
  <div class="input-group flex-nowrap">
    <span class="input-group-text"><em class="bi bi-lock me-1"></em><%= _('Passphrase') %></span>
    <%= f.text_field(:passphrase, {
      class: "form-control",
      autocomplete: "off",
      spellcheck: "false",
      placeholder: _('Optional: Require recipients to enter a passphrase to view this push'),
      "data-passphrase-field-target": "input",
      "data-action": "input->passphrase-field#changed"
    }) %>
    <button type="button"
            hidden
            class="btn btn-outline-secondary passphrase-copy"
            data-passphrase-field-target="copyButton"
            data-action="passphrase-field#copy"
            aria-label="<%= _('Copy to clipboard') %>"
            title="<%= _('Copy to clipboard') %>">
      <em class="bi bi-clipboard" data-passphrase-field-target="copyIcon" aria-hidden="true"></em>
    </button>
    <button type="button"
            hidden
            class="btn btn-outline-secondary passphrase-clear"
            data-passphrase-field-target="clearButton"
            data-action="passphrase-field#clear"
            aria-label="<%= _('Clear passphrase') %>"
            title="<%= _('Clear passphrase') %>">
      <em class="bi bi-x-lg" aria-hidden="true"></em>
    </button>
    <button type="button"
            class="btn btn-primary passphrase-generate"
            data-passphrase-field-target="generateButton"
            data-action="passphrase-field#generate"
            aria-label="<%= _('Generate passphrase') %>"
            title="<%= _('Generate passphrase') %>">
      <em class="bi bi-shuffle" aria-hidden="true"></em>
    </button>
  </div>
  <div class="passphrase-field-error small text-danger mt-1" hidden data-passphrase-field-target="error" role="alert"></div>
</div>
