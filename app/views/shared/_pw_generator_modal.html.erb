<div class="modal fade" id="configureModal" tabindex="-1" aria-labelledby="configureModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-semibold" id="configureModalLabel"><em class="bi bi-sliders me-2"></em><%= _('Configure Password Generation') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="bg-body-tertiary rounded-3 p-4 mb-4 text-center position-relative">
          <div class="text-muted small mb-1"><%= _('Preview') %></div>
          <div class="fs-4 fw-medium text-break font-monospace" id="configure_password_payload" data-pwgen-target="testPayloadArea">
            <%= _('Test Area') %>
          </div>
          <div class="small text-muted mt-2" data-pwgen-target="entropyArea"></div>
          <button class="btn btn-primary btn-sm position-absolute bottom-0 end-0 m-2" type="button" id="configure_generate_password"
              data-action="click->pwgen#testGenerate">
            <em class="bi bi-shuffle me-1"></em><%= _('Test') %>
          </button>
        </div>

        <div class="btn-group w-100 mb-4" role="group" aria-label="<%= _('Generator type') %>">
          <input type="radio" class="btn-check" name="pwgen_type" id="pwgen_type_passphrase" value="passphrase" data-pwgen-target="typeInput" data-action="change->pwgen#typeChanged">
          <label class="btn btn-outline-primary" for="pwgen_type_passphrase"><%= _('Passphrase') %></label>
          <input type="radio" class="btn-check" name="pwgen_type" id="pwgen_type_password" value="password" data-pwgen-target="typeInput" data-action="change->pwgen#typeChanged">
          <label class="btn btn-outline-primary" for="pwgen_type_password"><%= _('Password') %></label>
          <input type="radio" class="btn-check" name="pwgen_type" id="pwgen_type_pin" value="pin" data-pwgen-target="typeInput" data-action="change->pwgen#typeChanged">
          <label class="btn btn-outline-primary" for="pwgen_type_pin"><%= _('PIN') %></label>
        </div>

        <div data-pwgen-target="passphraseFields">
          <div class="mb-3">
            <label for="pwgen_language" class="form-label small text-muted"><%= _('Language') %></label>
            <select class="form-select" id="pwgen_language" data-pwgen-target="languageInput">
              <option value="en"><%= _('English') %></option>
              <option value="es"><%= _('Spanish') %></option>
              <option value="fr"><%= _('French') %></option>
              <option value="de"><%= _('German') %></option>
              <option value="it"><%= _('Italian') %></option>
            </select>
          </div>
          <div class="mb-3">
            <label for="pwgen_word_count" class="form-label small text-muted"><%= _('Number of Words') %></label>
            <input type="number" class="form-control" id="pwgen_word_count" min="3" max="10" data-pwgen-target="wordCountInput" autocomplete="off">
          </div>
          <div class="mb-3">
            <label for="pwgen_separator" class="form-label small text-muted"><%= _('Separator') %></label>
            <input class="form-control font-monospace" type="text" id="pwgen_separator" maxlength="8" data-pwgen-target="separatorInput" autocomplete="off">
          </div>
          <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="pwgen_capitalize" data-pwgen-target="capitalizeCheckbox">
            <label class="form-check-label" for="pwgen_capitalize"><%= _('Capitalize words') %></label>
          </div>
          <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="pwgen_number" data-pwgen-target="numberCheckbox">
            <label class="form-check-label" for="pwgen_number"><%= _('Append numbers') %></label>
          </div>
          <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="pwgen_symbol" data-pwgen-target="symbolCheckbox">
            <label class="form-check-label" for="pwgen_symbol"><%= _('Append a symbol') %></label>
          </div>
        </div>

        <div data-pwgen-target="passwordFields" class="d-none">
          <div class="mb-3">
            <label for="pwgen_password_length" class="form-label small text-muted"><%= _('Length') %></label>
            <input type="number" class="form-control" id="pwgen_password_length" min="4" max="128" data-pwgen-target="passwordLengthInput" autocomplete="off">
          </div>
          <div class="mb-3">
            <label for="pwgen_charset" class="form-label small text-muted"><%= _('Character set') %></label>
            <select class="form-select" id="pwgen_charset" data-pwgen-target="charsetInput">
              <option value="ascii">ASCII</option>
              <option value="latin"><%= _('Latin (includes accents)') %></option>
              <option value="cyrillic"><%= _('Cyrillic') %></option>
              <option value="greek"><%= _('Greek') %></option>
            </select>
          </div>
          <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="pwgen_uppercase" data-pwgen-target="uppercaseCheckbox">
            <label class="form-check-label" for="pwgen_uppercase"><%= _('Uppercase') %></label>
          </div>
          <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="pwgen_lowercase" data-pwgen-target="lowercaseCheckbox">
            <label class="form-check-label" for="pwgen_lowercase"><%= _('Lowercase') %></label>
          </div>
          <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="pwgen_digits" data-pwgen-target="digitsCheckbox">
            <label class="form-check-label" for="pwgen_digits"><%= _('Digits') %></label>
          </div>
          <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="pwgen_symbols" data-pwgen-target="symbolsCheckbox">
            <label class="form-check-label" for="pwgen_symbols"><%= _('Symbols') %></label>
          </div>
          <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="pwgen_avoid_ambiguous" data-pwgen-target="avoidAmbiguousCheckbox">
            <label class="form-check-label" for="pwgen_avoid_ambiguous"><%= _('Avoid ambiguous characters') %></label>
          </div>
        </div>

        <div data-pwgen-target="pinFields" class="d-none">
          <div class="mb-3">
            <label for="pwgen_pin_length" class="form-label small text-muted"><%= _('PIN length') %></label>
            <input type="number" class="form-control" id="pwgen_pin_length" min="4" max="12" data-pwgen-target="pinLengthInput" autocomplete="off">
          </div>
        </div>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-outline-secondary" id="reset_to_defaults" data-action="click->pwgen#resetSettings">
          <em class="bi bi-arrow-counterclockwise me-1"></em><%= _('Reset to Defaults') %>
        </button>
        <button type="button" class="btn btn-primary" id="save_configure" data-bs-dismiss="modal" data-action="click->pwgen#saveSettings">
          <em class="bi bi-check-lg me-1"></em><%= _('Save') %>
        </button>
      </div>
    </div>
  </div>
</div>
